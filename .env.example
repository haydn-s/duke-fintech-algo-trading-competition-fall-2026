# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Note what is NOT here: host, port, and client id are not secret and live in
# configs/live.yaml. The Python API never logs in -- it connects to a gateway
# that is already authenticated -- so these are the only values that have to
# stay out of git.

# REQUIRED. Your paper account id, shown top-right in Client Portal once you
# switch to the paper account. Starts with DU. The run refuses anything else,
# so a live account id cannot be used by accident.
IBKR_ACCOUNT=DU0000000

# OPTIONAL. Only needed if IBC logs the gateway in for you on a schedule.
# If you start IB Gateway by hand and type the password yourself, delete both
# lines -- a stored brokerage password you never read back is pure liability.
#IBKR_USERNAME=your_paper_username
#IBKR_PASSWORD=your_paper_password
